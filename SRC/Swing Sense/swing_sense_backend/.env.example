# Copie este arquivo para ".env" antes de rodar o backend localmente.
# O banco de dados e o PostgreSQL do Supabase - preencha com as credenciais
# do seu projeto (Project Settings > Database > Connection string, modo
# "Session pooler" na porta 5432).
# NUNCA versione o ".env" (ele ja esta no .gitignore e no .dockerignore).

PORT=8080

# development | production. Em production a API recusa subir com JWT_SECRET fraco.
APP_ENV=development

# OBRIGATORIO em producao: segredo aleatorio com >= 32 caracteres. Gere com:
#   openssl rand -base64 48
# Deixe vazio em desenvolvimento para usar um segredo aleatorio temporario.
JWT_SECRET=

# Validade do token em horas (padrao 24, maximo 72).
JWT_EXPIRES_IN_HOURS=24

# Origens web autorizadas a chamar a API pelo navegador (separadas por virgula).
# Apps nativos (Android/iOS) nao precisam disto. Em desenvolvimento localhost ja e liberado.
# Exemplo: CORS_ALLOWED_ORIGINS=https://app.seudominio.com
CORS_ALLOWED_ORIGINS=

# Defina true SOMENTE se a API estiver atras de proxy reverso/TLS confiavel
# (usa X-Forwarded-For / X-Forwarded-Proto para IP do cliente e HSTS).
TRUST_PROXY=false

# TLS nativo opcional (alternativa ao proxy). Caminhos para certificado e chave PEM.
# TLS_CERT_PATH=/certs/fullchain.pem
# TLS_KEY_PATH=/certs/privkey.pem

# Limite do corpo das requisicoes em bytes (padrao 262144 = 256 KiB).
# MAX_BODY_BYTES=262144

DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.SEU_PROJETO_REF
DB_PASSWORD=troque-pela-senha-do-banco
# disable | require | verify-full (padrao: require). Use require/verify-full sempre.
DB_SSL_MODE=require
